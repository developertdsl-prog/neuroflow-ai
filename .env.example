# NeuroFlow-AI Environment Configuration
PORT=5000
NODE_ENV=production

# Persistence Engines
MONGODB_URI=mongodb://localhost:27017/neuroflow_ai
REDIS_URL=redis://localhost:6379

# Multi-Model LLM Gateway Keys
OPENAI_API_KEY=sk-neuroflow-live-mock-openai-key-2026
ANTHROPIC_API_KEY=sk-ant-neuroflow-live-mock-anthropic-key-2026
GEMINI_API_KEY=ai-gemini-neuroflow-live-mock-key-2026

# Security & Authorization
API_KEY_SECRET=neuroflow_live_auth_secret_token_9941
JWT_SECRET=super_secure_jwt_neuroflow_secret_key_2026
RATE_LIMIT_MAX_PER_MINUTE=600

# Operational Thresholds
MAX_CONCURRENT_AGENT_WORKFLOWS=64
VECTOR_SIMILARITY_THRESHOLD=0.78
GUARDRAIL_STRICT_MODE=true
LOG_LEVEL=info
